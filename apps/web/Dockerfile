FROM node:22-alpine

ARG NEXT_PUBLIC_API_URL=http://localhost:4000
ARG NEXT_PUBLIC_ZONK_CHAIN_ID=84532
ARG NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ARG NEXT_PUBLIC_BASE_MAINNET_RPC_URL=https://mainnet.base.org
ARG NEXT_PUBLIC_PRIVY_APP_ID
ARG NEXT_PUBLIC_ZONK_FACTORY_V3_ADDRESS
ARG NEXT_PUBLIC_FEE_MANAGER_V3_ADDRESS
ARG NEXT_PUBLIC_GRADUATION_MANAGER_V3_ADDRESS
ARG NEXT_PUBLIC_PERMANENT_LP_FEE_VAULT_V3_ADDRESS
ARG NEXT_PUBLIC_PERMANENT_LP_CUSTODIAN_DEPLOYER_V3_ADDRESS
ARG NEXT_PUBLIC_GRADUATION_SETTLEMENT_EXECUTOR_V3_ADDRESS
ARG NEXT_PUBLIC_BASE_SEPOLIA_UNISWAP_V3_QUOTER_V2
ARG NEXT_PUBLIC_BASE_SEPOLIA_UNISWAP_V3_SWAP_ROUTER_02
ARG NEXT_PUBLIC_BASE_SEPOLIA_UNISWAP_V3_FACTORY
ARG NEXT_PUBLIC_BASE_MAINNET_UNISWAP_V3_QUOTER_V2
ARG NEXT_PUBLIC_BASE_MAINNET_UNISWAP_V3_SWAP_ROUTER_02
ARG NEXT_PUBLIC_BASE_MAINNET_UNISWAP_V3_FACTORY
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_ZONK_CHAIN_ID=$NEXT_PUBLIC_ZONK_CHAIN_ID
ENV NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=$NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL
ENV NEXT_PUBLIC_BASE_MAINNET_RPC_URL=$NEXT_PUBLIC_BASE_MAINNET_RPC_URL
ENV NEXT_PUBLIC_PRIVY_APP_ID=$NEXT_PUBLIC_PRIVY_APP_ID
ENV NEXT_PUBLIC_ZONK_FACTORY_V3_ADDRESS=$NEXT_PUBLIC_ZONK_FACTORY_V3_ADDRESS
ENV NEXT_PUBLIC_FEE_MANAGER_V3_ADDRESS=$NEXT_PUBLIC_FEE_MANAGER_V3_ADDRESS
ENV NEXT_PUBLIC_GRADUATION_MANAGER_V3_ADDRESS=$NEXT_PUBLIC_GRADUATION_MANAGER_V3_ADDRESS
ENV NEXT_PUBLIC_PERMANENT_LP_FEE_VAULT_V3_ADDRESS=$NEXT_PUBLIC_PERMANENT_LP_FEE_VAULT_V3_ADDRESS
ENV NEXT_PUBLIC_PERMANENT_LP_CUSTODIAN_DEPLOYER_V3_ADDRESS=$NEXT_PUBLIC_PERMANENT_LP_CUSTODIAN_DEPLOYER_V3_ADDRESS
ENV NEXT_PUBLIC_GRADUATION_SETTLEMENT_EXECUTOR_V3_ADDRESS=$NEXT_PUBLIC_GRADUATION_SETTLEMENT_EXECUTOR_V3_ADDRESS
ENV NEXT_PUBLIC_BASE_SEPOLIA_UNISWAP_V3_QUOTER_V2=$NEXT_PUBLIC_BASE_SEPOLIA_UNISWAP_V3_QUOTER_V2
ENV NEXT_PUBLIC_BASE_SEPOLIA_UNISWAP_V3_SWAP_ROUTER_02=$NEXT_PUBLIC_BASE_SEPOLIA_UNISWAP_V3_SWAP_ROUTER_02
ENV NEXT_PUBLIC_BASE_SEPOLIA_UNISWAP_V3_FACTORY=$NEXT_PUBLIC_BASE_SEPOLIA_UNISWAP_V3_FACTORY
ENV NEXT_PUBLIC_BASE_MAINNET_UNISWAP_V3_QUOTER_V2=$NEXT_PUBLIC_BASE_MAINNET_UNISWAP_V3_QUOTER_V2
ENV NEXT_PUBLIC_BASE_MAINNET_UNISWAP_V3_SWAP_ROUTER_02=$NEXT_PUBLIC_BASE_MAINNET_UNISWAP_V3_SWAP_ROUTER_02
ENV NEXT_PUBLIC_BASE_MAINNET_UNISWAP_V3_FACTORY=$NEXT_PUBLIC_BASE_MAINNET_UNISWAP_V3_FACTORY

WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json ./apps/web/package.json
COPY packages ./packages
RUN pnpm install --frozen-lockfile
COPY apps/web ./apps/web
RUN pnpm --filter web build

WORKDIR /app/apps/web
EXPOSE 3000
CMD ["pnpm", "start"]
