{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Zonk.fun",
  "description": "Official documentation for the Zonk.fun permissionless token launchpad on Base.",
  "colors": {
    "primary": "#06B6D4",
    "light": "#22D3EE",
    "dark": "#2563EB"
  },
  "appearance": {
    "default": "dark"
  },
  "background": {
    "decoration": "grid"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "dark"
  },
  "icons": {
    "library": "lucide"
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/deseti/zonk-fun"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open Zonk.fun",
      "href": "https://zonk.fun"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt"],
    "display": "toc"
  },
  "navigation": {
    "groups": [
      {
        "group": "Overview",
        "pages": ["docs/index", "docs/getting-started/introduction"]
      },
      {
        "group": "Getting Started",
        "pages": ["docs/getting-started/quickstart", "docs/getting-started/connect-wallet", "docs/getting-started/base-mainnet"]
      },
      {
        "group": "Using Zonk.fun",
        "pages": ["docs/users/create-token", "docs/users/buy-tokens", "docs/users/sell-tokens", "docs/users/discovery", "docs/users/token-pages", "docs/users/transaction-flow"]
      },
      {
        "group": "Protocol",
        "pages": ["docs/protocol/overview", "docs/protocol/architecture", "docs/protocol/bonding-curve", "docs/protocol/token-economics", "docs/protocol/fees", "docs/protocol/graduation", "docs/protocol/uniswap-v3", "docs/protocol/liquidity-custody"]
      },
      {
        "group": "Contracts",
        "pages": ["docs/contracts/overview", "docs/contracts/deployments", "docs/contracts/factory", "docs/contracts/curve", "docs/contracts/token", "docs/contracts/fee-manager", "docs/contracts/graduation-manager", "docs/contracts/vaults"]
      },
      {
        "group": "Developers",
        "pages": ["docs/developers/overview", "docs/developers/architecture", "docs/developers/frontend", "docs/developers/api", "docs/developers/indexer", "docs/developers/database", "docs/developers/contract-sdk", "docs/developers/builder-code", "docs/developers/local-development", "docs/developers/environment"]
      },
      {
        "group": "API Reference",
        "pages": ["docs/api-reference/overview", "docs/api-reference/tokens", "docs/api-reference/discovery", "docs/api-reference/trades", "docs/api-reference/metadata", "docs/api-reference/errors"]
      },
      {
        "group": "Operations",
        "pages": ["docs/operations/deployment", "docs/operations/production-architecture", "docs/operations/monitoring"]
      },
      {
        "group": "Security",
        "pages": ["docs/security/security-model", "docs/security/wallet-safety", "docs/security/smart-contract-safety", "docs/security/responsible-disclosure"]
      },
      {
        "group": "Reference",
        "pages": ["docs/reference/contract-addresses", "docs/reference/networks", "docs/reference/glossary", "docs/reference/faq", "docs/reference/troubleshooting"]
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/deseti/zonk-fun"
    }
  }
}
