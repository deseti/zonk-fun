# Application
APP_ENV=development

# API
API_HOST=0.0.0.0
API_PORT=4000

# PostgreSQL
POSTGRES_DB=zonk
POSTGRES_USER=zonk
POSTGRES_PASSWORD=zonk_local
DATABASE_URL=postgres://zonk:zonk_local@localhost:15434/zonk?sslmode=disable

# Redis
