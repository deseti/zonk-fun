# Application
APP_ENV=development

# API
API_HOST=0.0.0.0
API_PORT=4000

# PostgreSQL
POSTGRES_DB=zonk
POSTGRES_USER=zonk
POSTGRES_PASSWORD=replace_with_local_secret
# Use the same local password as POSTGRES_PASSWORD. This URL is for Compose services.
DATABASE_URL=postgresql://zonk:replace_with_local_secret@postgres:5432/zonk?sslmode=disable

# Redis
REDIS_URL=redis://redis:6379/0

# Base
BASE_SEPOLIA_RPC_URL=
BASE_MAINNET_RPC_URL=
BASE_SEPOLIA_CHAIN_ID=84532
DEPLOYER_PRIVATE_KEY=
GOVERNANCE_ADDRESS=
PROTOCOL_TREASURY=
PROTOCOL_FEE_BPS=
CREATOR_FEE_BPS=
LP_BENEFICIARY=
LP_LOCK_DURATION=
MAX_LIQUIDITY_SLIPPAGE_BPS=
LIQUIDITY_MANAGER_ADDRESS=
# Phase 10 only: configure after a reviewed real adapter is approved.
DEX_ADAPTER_ADDRESS=
ZONK_FACTORY_ADDRESS=
ZONK_CURVE_ADDRESS=
ZONK_TOKEN_ADDRESS=
TOKEN_NAME=Local Zonk
TOKEN_SYMBOL=LZONK
TOKEN_INITIAL_SUPPLY=1000000000000000000000
CURVE_SUPPLY=100000000000000000000
CURVE_STARTING_PRICE=1000000000000000
CURVE_SLOPE=100000000000000
CURVE_GRADUATION_THRESHOLD=90000000000000000000
BUY_TOKEN_AMOUNT=1000000000000000000
BUY_MAX_RESERVE_IN=0
SELL_TOKEN_AMOUNT=1000000000000000000
SELL_MIN_RESERVE_OUT=0

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CHAIN_ID=

# Indexer (leave empty for safe local idle mode)
INDEXER_MODE=idle
