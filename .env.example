# ============================================================
# ZONK.FUN BASE MAINNET ENVIRONMENT TEMPLATE
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

APP_ENV=development

# Selected runtime network.
#
# Base Mainnet only: 8453.
ZONK_CHAIN_ID=8453


# ============================================================
# API
# ============================================================

API_HOST=0.0.0.0
API_PORT=4000


# ============================================================
# PostgreSQL
# ============================================================

POSTGRES_DB=zonk
POSTGRES_USER=zonk
POSTGRES_PASSWORD=replace_with_local_secret

# Compose service connection string.
# Use the same local secret as POSTGRES_PASSWORD.
DATABASE_URL=postgresql://zonk:${POSTGRES_PASSWORD}@postgres:5432/zonk?sslmode=disable


# ============================================================
# FRONTEND / PUBLIC CONFIGURATION
# ============================================================
#
# Everything beginning with NEXT_PUBLIC_ is exposed to the
# browser. NEVER place private RPC credentials, private keys,
# API secrets, Safe signer secrets, or authorization keys here.
# ============================================================

NEXT_PUBLIC_API_URL=http://localhost:4000
INTERNAL_API_URL=http://api:4000

# Keep this equal to ZONK_CHAIN_ID for standalone web builds.
#
# Base Sepolia: 84532
# Base Mainnet: 8453
NEXT_PUBLIC_ZONK_CHAIN_ID=8453


# ------------------------------------------------------------
# Browser-safe RPCs
# ------------------------------------------------------------

# Base Mainnet browser-safe RPC.
#
# https://mainnet.base.org is suitable as a public fallback /
# development endpoint but is rate-limited and should not be
# treated as the production backend RPC.
NEXT_PUBLIC_BASE_MAINNET_RPC_URL=https://mainnet.base.org


# ============================================================
# ZONK V3 DEPLOYMENT ADDRESSES
# ============================================================
#
# These are populated after deployment for the selected chain.
# Never reuse Base Sepolia Zonk addresses on Base Mainnet.
# ============================================================

# Server/indexer factory address.
ZONK_FACTORY_V3_ADDRESS=

# Browser-visible Zonk deployment addresses.
NEXT_PUBLIC_ZONK_FACTORY_V3_ADDRESS=0x0000000000000000000000000000000000000000

NEXT_PUBLIC_FEE_MANAGER_V3_ADDRESS=0x0000000000000000000000000000000000000000

NEXT_PUBLIC_GRADUATION_MANAGER_V3_ADDRESS=0x0000000000000000000000000000000000000000

NEXT_PUBLIC_PERMANENT_LP_FEE_VAULT_V3_ADDRESS=0x0000000000000000000000000000000000000000

NEXT_PUBLIC_PERMANENT_LP_CUSTODIAN_DEPLOYER_V3_ADDRESS=0x0000000000000000000000000000000000000000

NEXT_PUBLIC_GRADUATION_SETTLEMENT_EXECUTOR_V3_ADDRESS=0x0000000000000000000000000000000000000000


# ============================================================
# UNISWAP V3 — BASE SEPOLIA
# ============================================================

NEXT_PUBLIC_BASE_SEPOLIA_UNISWAP_V3_QUOTER_V2=0xC5290058841028F1614F3A6F0F5816cAd0df5E27

NEXT_PUBLIC_BASE_SEPOLIA_UNISWAP_V3_SWAP_ROUTER_02=0x94cC0AaC535CCDB3C01d6787D6413C739ae12bc4

NEXT_PUBLIC_BASE_SEPOLIA_UNISWAP_V3_FACTORY=0x4752ba5DBc23f44D87826276BF6Fd6b1C372aD24


# ============================================================
# UNISWAP V3 — BASE MAINNET
# ============================================================

NEXT_PUBLIC_BASE_MAINNET_UNISWAP_V3_QUOTER_V2=0x3d4e44Eb1374240CE5F1B871ab261CD16335B76a

NEXT_PUBLIC_BASE_MAINNET_UNISWAP_V3_SWAP_ROUTER_02=0x2626664c2603336E57B271c5C0b26F421741e481

NEXT_PUBLIC_BASE_MAINNET_UNISWAP_V3_FACTORY=0x33128a8fC17869897dcE68Ed026d694621f6FDfD

# Foundry / server-side Mainnet Uniswap inputs for DeployV3BaseMainnet.
# Public canonical addresses only. Must match the hardcoded script constants.
BASE_MAINNET_UNISWAP_V3_FACTORY=0x33128a8fC17869897dcE68Ed026d694621f6FDfD
BASE_MAINNET_WETH=0x4200000000000000000000000000000000000006
BASE_MAINNET_NONFUNGIBLE_POSITION_MANAGER=0x03a520b32C04BF3bEEf7BEb72E919cf822Ed34f1


# ============================================================
# REDIS
# ============================================================

REDIS_URL=redis://redis:6379/0


# ============================================================
# SERVER-SIDE RPC
# ============================================================
#
# These values are server-side only.
# They may contain provider credentials/API keys.
# NEVER rename these to NEXT_PUBLIC_*.
# ============================================================

# Base Sepolia server RPC.
BASE_SEPOLIA_RPC_URL=

# Base Mainnet production RPC.
#
# For production VPS use a dedicated/private RPC provider.
# Do not rely on the public Base endpoint for production traffic.
BASE_MAINNET_RPC_URL=


# ============================================================
# CHAINLINK ETH/USD PRICE FEEDS
# ============================================================
#
# Network-specific onchain Chainlink Standard Price Feeds.
# The API reads these contracts using eth_call.
# Never reuse a Sepolia feed on Mainnet.
# ============================================================

# Base Sepolia ETH/USD.
BASE_SEPOLIA_CHAINLINK_ETH_USD_FEED=0x4aDC67696bA383F43DD60A9e78F2C97Fbbfc7cb1

# Base Mainnet ETH/USD Standard Price Feed.
BASE_MAINNET_CHAINLINK_ETH_USD_FEED=0x71041dddad3595F9CEd3DcCFBe3D1F4b0a16Bb70

# Maximum accepted age of Chainlink price data.
CHAINLINK_ETH_USD_MAX_AGE=1h


# ============================================================
# DEPLOYMENT / GOVERNANCE CEREMONY
# ============================================================
#
# Deployment-only values.
#
# These are NOT normal VPS runtime configuration.
#
# Mainnet process:
#
# 1. Dedicated deployer EOA performs deployment/bootstrap.
# 2. Verify every one-shot bootstrap authority is address(0).
# 3. Transfer persistent Ownable2Step ownerships to the
#    Protocol/Governance Safe.
# 4. Protocol/Governance Safe accepts ownership.
# 5. Verify deployer retains no persistent authority.
#
# NEVER commit a real private key.
# Never use --private-key. Never put a raw private key in .env.
# DeployV3BaseMainnet.s.sol NEVER reads DEPLOYER_PRIVATE_KEY.
# Foundry --sender sets script msg.sender. --account only unlocks
# a keystore and does NOT set msg.sender.
# Simulation may use --sender 0x2e9f4a39F0530FC8521997d9eC634A637d49FBac.
# Keystore-backed signing/broadcast MUST use BOTH:
#   --account zonk-mainnet-deployer
#   --sender 0x2e9f4a39F0530FC8521997d9eC634A637d49FBac
# ============================================================

# Base Sepolia / legacy scripts only. Not used by DeployV3BaseMainnet.
# Do not reuse this as the Base Mainnet signing method.
DEPLOYER_PRIVATE_KEY=

# Temporary bootstrap governance.
#
# For Zonk Mainnet deployment this is the dedicated
# Mainnet Deployer EOA (public address only):
#
# 0x2e9f4a39F0530FC8521997d9eC634A637d49FBac
#
# DeployV3BaseMainnet validates msg.sender against that hardcoded
# address. Foundry --sender sets msg.sender; --account does not.
# It does not read a private key from this file. Keep the example
# blank in the repository unless the project intentionally wants
# the public deployment address documented.
V3_GOVERNANCE_ADDRESS=

# Protocol/Governance Safe (2-of-3).
# Base Mainnet: 0x71B20D47152Cdf6f9bb1b0CCd0C0FBA52b86a102
V3_TREASURY_SAFE=

# Community Treasury Safe (2-of-3).
# Base Mainnet: 0x11Dbc46C527a76EE9bf167835478EC06F73B7f4b
V3_COMMUNITY_TREASURY_SAFE=


# ============================================================
# LEGACY / LOCAL DEPLOYMENT TOOL INPUTS
# ============================================================
#
# Retained only for existing local tooling.
# Do not use these to override the canonical V3 economics.
# ============================================================

PROTOCOL_FEE_BPS=
CREATOR_FEE_BPS=

TOKEN_NAME=Local Zonk
TOKEN_SYMBOL=LZONK
TOKEN_INITIAL_SUPPLY=1000000000000000000000


# ============================================================
# INDEXER
# ============================================================

# Safe local default.
#
# idle   = no active blockchain indexing
# active = live indexing
INDEXER_MODE=idle

# First block indexed by a fresh deployment.
#
# Base Mainnet:
# set this to the exact Zonk Mainnet deployment block during
# Phase 11E.
#
# Never reuse the Base Sepolia start block/checkpoint on Mainnet.
INDEXER_START_BLOCK=

# Optional finite stop block for controlled/test runs.
# Leave empty for continuous indexing.
INDEXER_STOP_BLOCK=

# Number of block confirmations before canonical indexing.
INDEXER_CONFIRMATIONS=6

# Number of blocks fetched per indexing batch.
INDEXER_BATCH_SIZE=500

# RPC retry policy.
INDEXER_RPC_MAX_ATTEMPTS=3
INDEXER_RPC_INITIAL_DELAY_MS=100
INDEXER_RPC_MAX_DELAY_MS=2000

# Comma-separated deployed Zonk protocol addresses.
#
# If omitted, the selected chain's ZONK_FACTORY_V3_ADDRESS is
# used as the initial discovery address.
#
# Mainnet values are populated only after fresh V3 deployment.
ZONK_INDEXER_CONTRACTS=
