# Base
BASE_SEPOLIA_RPC_URL=
BASE_MAINNET_RPC_URL=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CHAIN_ID=

# Indexer (leave empty for safe local idle mode)
INDEXER_MODE=idle
