# Application
APP_ENV=development

# API
API_HOST=0.0.0.0
API_PORT=4000

# PostgreSQL
POSTGRES_DB=zonk
POSTGRES_USER=zonk
POSTGRES_PASSWORD=replace_with_local_secret
# Use the same local password as POSTGRES_PASSWORD. This URL is for Compose services.
DATABASE_URL=postgresql://zonk:${POSTGRES_PASSWORD}@postgres:5432/zonk?sslmode=disable

# Frontend-safe public configuration. Do not put credentials or private keys here.
NEXT_PUBLIC_API_URL=http://localhost:4000
INTERNAL_API_URL=http://api:4000
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Public Privy App ID. Never put Privy authorization keys or secrets here.
NEXT_PUBLIC_PRIVY_APP_ID=
# Set deployed non-zero addresses locally when available.
NEXT_PUBLIC_ZONK_FACTORY_V3_ADDRESS=0x0000000000000000000000000000000000000000

# Redis
REDIS_URL=redis://redis:6379/0

# Base
BASE_SEPOLIA_RPC_URL=
BASE_MAINNET_RPC_URL=
BASE_SEPOLIA_CHAIN_ID=84532
DEPLOYER_PRIVATE_KEY=
GOVERNANCE_ADDRESS=
PROTOCOL_TREASURY=
PROTOCOL_FEE_BPS=
CREATOR_FEE_BPS=
ZONK_FACTORY_V3_ADDRESS=
TOKEN_NAME=Local Zonk
TOKEN_SYMBOL=LZONK
TOKEN_INITIAL_SUPPLY=1000000000000000000000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CHAIN_ID=

# Indexer (leave empty for safe local idle mode)
INDEXER_MODE=idle
INDEXER_START_BLOCK=
INDEXER_STOP_BLOCK=
INDEXER_CONFIRMATIONS=6
INDEXER_BATCH_SIZE=500
INDEXER_RPC_MAX_ATTEMPTS=3
INDEXER_RPC_INITIAL_DELAY_MS=100
INDEXER_RPC_MAX_DELAY_MS=2000
# Comma-separated deployed protocol addresses. If omitted, the individual
# *_ADDRESS variables below are used when active indexing is enabled.
ZONK_INDEXER_CONTRACTS=
